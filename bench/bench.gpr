with "../tessera.gpr";

--  The benchmark: reads named columns of a local Parquet file through
--  Tessera.Files and prints rows, megabytes and seconds per column.  Not
--  run by CI (there is no real file there); CI only builds it.
project Bench is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("tessera_bench.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O3", "-gnatn", "-gnatwa", "-gnatwe", "-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback.
   end Binder;

end Bench;
