with "config/tessera_config.gpr";
with "sml";

--  Tessera: reads the flat-table subset of Apache Parquet that pyarrow
--  writes.  src/core holds the SPARK-proven decoders (Thrift compact,
--  the footer, Snappy, the RLE/bit-packed hybrid, pages, columns): pure
--  functions over byte arrays, zero IO.  src/app holds the one unit that
--  touches the disk (Tessera.Files).  proof/proof.gpr sources src/core
--  directly and withs nothing, keeping foreign code out of the proof
--  tree.
project Tessera is

   for Library_Name use "Tessera";
   for Library_Version use
     Project'Library_Name & ".so." & Tessera_Config.Crate_Version;

   for Source_Dirs use ("src/core", "src/app", "config");
   for Object_Dir use "obj/" & Tessera_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TESSERA_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Tessera_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Tessera;
